# Скопируй в .env.local и подставь значения из Supabase → Project Settings → API Keys.
# Оба значения публичные: доступ к данным защищают RLS-политики в базе.
# Без них приложение работает локально, без входа и синхронизации.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
